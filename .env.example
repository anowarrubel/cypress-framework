# Copy to .env for local runs:  cp .env.example .env
# .env is gitignored. In CI these come from workflow inputs and repo secrets.

# Environment to run against: dev | qa | prod
TEST_ENV=qa

# Site to run. Leave empty to run every site.
# Values: demoqa | academybugs | saucedemo
SITE=

# Sauce Demo's logins are public; use real secrets for anything else and
# never commit them.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Point a site at a real host without editing config/sites.ts.
# Pattern: <SITE>_<ENV>_URL
# DEMOQA_DEV_URL=https://dev.example.com
# SAUCEDEMO_QA_URL=https://qa.example.com
